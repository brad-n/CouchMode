    "season": { "open": "https://www.disneyplus.com/browse/search", "ready": "pageReady", "reuseSitePage": true },
    "search": { "open": "https://www.disneyplus.com/browse/search", "ready": "pageReady", "reuseSitePage": true },
    "more": { "open": "https://www.disneyplus.com/browse/search", "ready": "pageReady", "reuseSitePage": true },
    "profile": { "open": "https://www.disneyplus.com/browse/search", "ready": "pageReady", "reuseSitePage": true, "settled": "profileSettled", "confirmTimeout": 15 },
    "restore": { "open": "https://www.disneyplus.com/select-profile", "ready": "pickerReady", "settled": "leftPicker", "confirmTimeout": 15 }
