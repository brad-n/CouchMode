# Copy to scripts/local.env (ignored by git) and fill in for your machines;
# build-app.sh and deploy.sh read it.
# The Mac that runs the shell, as an ssh destination:
HTPC_HOST=user@mac-mini.local
# A code-signing identity from `security find-identity -v -p codesigning`.
# A stable identity keeps macOS permissions (Screen Recording, Accessibility,
# keychain "Always Allow") across rebuilds; unset means ad-hoc signing.
HTPC_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Release pipeline (scripts/release.sh). HTPC_SIGN_IDENTITY above must be a Developer ID Application identity.
# App Store Connect API key for notarization, read from the login Keychain as generic passwords:
# the .p8 contents (PEM or base64 of it) and the issuer id. NOTARY_KEY_ID is the key's id.
NOTARY_KEYCHAIN_KEY_SERVICE=your-asc-key-keychain-service
NOTARY_KEYCHAIN_ISSUER_SERVICE=your-asc-issuer-keychain-service
NOTARY_KEY_ID=ABCDE12345
