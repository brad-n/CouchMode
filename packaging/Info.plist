<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>CouchMode</string>
<key>CFBundleIdentifier</key><string>local.brad.htpcshell</string>
<key>CFBundleName</key><string>CouchMode</string>
<key>CFBundleDisplayName</key><string>CouchMode</string>
<key>CFBundlePackageType</key><string>APPL</string>
<!-- Release version (packaging/VERSION or $COUCHMODE_VERSION); build = commit count, so it always increases
     (Sparkle compares it); the commit hash has its own key. -->
<key>CFBundleShortVersionString</key><string>__VERSION__</string>
<key>CFBundleVersion</key><string>__BUILD__</string>
<key>CouchModeGitSHA</key><string>__SHA__</string>
<!-- Sparkle self-update. The public key pairs with the private key in the release Mac's login Keychain
     (see agents/release.md). -->
<key>SUFeedURL</key><string>https://github.com/brad-n/CouchMode/releases/latest/download/appcast.xml</string>
<key>SUPublicEDKey</key><string>QDBQXhAV5xXxnbo23fB0TKIPswnru+XMvfnmQJL4d38=</string>
<key>SUEnableAutomaticChecks</key><true/>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>NSHighResolutionCapable</key><true/>
<!-- Browser-style app: let web pages follow plain-http hops (Disney+ uses one)
     like Safari does. Applies to WKWebView content only, not the app's own requests. -->
<key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoadsInWebContent</key><true/></dict>
</dict></plist>
